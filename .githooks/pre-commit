#!/bin/sh
# Pre-commit hook for Go Fiber Template
# This hook runs code quality checks before allowing commits

set -e

echo "Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    echo "${GREEN}✓${NC} $1"
}

print_warning() {
    echo "${YELLOW}⚠${NC} $1"
}

print_error() {
    echo "${RED}✗${NC} $1"
}

# Check if Go is installed
if ! command -v go > /dev/null 2>&1; then
    print_error "Go is not installed or not in PATH"
    exit 1
fi

# Get list of staged Go files
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
    print_warning "No Go files staged for commit"
    exit 0
fi

print_status "Found staged Go files: $(echo $STAGED_GO_FILES | wc -w) files"

# Check if files are properly formatted
print_status "Checking code formatting..."
UNFORMATTED_FILES=$(echo "$STAGED_GO_FILES" | xargs gofmt -l)
if [ -n "$UNFORMATTED_FILES" ]; then
    print_error "The following files are not properly formatted:"
    echo "$UNFORMATTED_FILES"
    print_error "Please run 'gofmt -w .' or 'make format' to fix formatting"
    exit 1
fi

# Check imports
print_status "Checking imports..."
if command -v goimports > /dev/null 2>&1; then
    UNFORMATTED_IMPORTS=$(echo "$STAGED_GO_FILES" | xargs goimports -l)
    if [ -n "$UNFORMATTED_IMPORTS" ]; then
        print_error "The following files have incorrect imports:"
        echo "$UNFORMATTED_IMPORTS"
        print_error "Please run 'goimports -w .' to fix imports"
        exit 1
    fi
else
    print_warning "goimports not found, skipping import check"
fi

# Run go vet
print_status "Running go vet..."
if ! go vet ./...; then
    print_error "go vet found issues"
    exit 1
fi

# Run golangci-lint if available (with limited checks for speed)
print_status "Running linter..."
if command -v golangci-lint > /dev/null 2>&1; then
    # Run with limited checks for faster execution
    if ! golangci-lint run --disable-all --enable=errcheck,gosimple,govet,ineffassign,staticcheck,typecheck,unused --new-from-rev=HEAD~1; then
        print_error "golangci-lint found issues"
        exit 1
    fi
else
    print_warning "golangci-lint not found, skipping advanced linting"
fi

# Run tests on staged files (optional - can be disabled for faster commits)
print_status "Running tests..."
if ! go test -short ./...; then
    print_error "Tests failed"
    exit 1
fi

# Check for TODO/FIXME comments in staged files
print_status "Checking for TODO/FIXME comments..."
TODO_COUNT=$(echo "$STAGED_GO_FILES" | xargs grep -n "TODO\|FIXME" || true)
if [ -n "$TODO_COUNT" ]; then
    print_warning "Found TODO/FIXME comments in staged files:"
    echo "$TODO_COUNT"
    print_warning "Consider addressing these before committing"
fi

# Check for debug statements
print_status "Checking for debug statements..."
DEBUG_STATEMENTS=$(echo "$STAGED_GO_FILES" | xargs grep -n "fmt\.Print\|log\.Print\|println" || true)
if [ -n "$DEBUG_STATEMENTS" ]; then
    print_error "Found debug print statements in staged files:"
    echo "$DEBUG_STATEMENTS"
    print_error "Please remove debug statements before committing"
    exit 1
fi

# Check for large files
print_status "Checking file sizes..."
for file in $STAGED_GO_FILES; do
    if [ -f "$file" ]; then
        size=$(wc -l < "$file")
        if [ "$size" -gt 500 ]; then
            print_warning "Large file detected: $file ($size lines)"
            print_warning "Consider breaking this file into smaller modules"
        fi
    fi
done

print_status "All pre-commit checks passed!"
exit 0